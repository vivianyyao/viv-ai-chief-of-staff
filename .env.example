# Copy this file to a new file named .env. Never put real secrets in this example file.

# Anthropic / Claude (required for the real SMS app)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Calendar OAuth (required for the real SMS app)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here
GOOGLE_CALENDAR_ID=primary

# Scheduling preferences
TIME_ZONE=America/Los_Angeles
WORKDAY_START=09:00
WORKDAY_END=17:00
SEARCH_DAYS=14

# Twilio webhook security (required after hosting the real app)
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# The only phone number allowed to text Viv, in E.164 format
ALLOWED_PHONE_NUMBER=+15551234567

# Exact public address from your hosting provider, with no slash at the end
PUBLIC_BASE_URL=https://your-app.example.com

# Web server (Render supplies PORT automatically; 3000 is for local use)
PORT=3000

# Keep false for the real webhook. The sms:local command overrides this automatically.
LOCAL_TEST_MODE=false
